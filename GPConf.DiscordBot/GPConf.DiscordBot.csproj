<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <UserSecretsId>gpc-dbot-secret</UserSecretsId>
        <!-- deploy/restart-bot.ps1 publishes into publish/, inside the project root. Unlike
             bin/obj, that folder isn't auto-excluded from the SDK's default item globs, so without
             this exclusion each republish glob-includes the previous publish output as content and
             copies it into itself — one nesting level (publish/publish/publish/...) deeper per run. -->
        <DefaultItemExcludes>$(DefaultItemExcludes);publish\**</DefaultItemExcludes>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Discord.Net" Version="3.20.1" />
        <PackageReference Include="ModelContextProtocol" Version="1.1.0" />
        <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.1.0" />
        <PackageReference Include="Google.Protobuf" Version="3.34.0" />
        <PackageReference Include="Grpc.Tools" Version="2.78.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    </ItemGroup>

    <ItemGroup>
        <Protobuf Include="..\Src\Protobuf\*.proto" ProtoRoot="..\Src\Protobuf" GrpcServices="None" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\Src\Utilities\ConfCupUtils.cs" Link="Utilities\ConfCupUtils.cs" />
        <Compile Include="..\Src\Utilities\ColorUtils.cs" Link="Utilities\ColorUtils.cs" />
        <Compile Include="..\Src\Utilities\BackupUtils.cs" Link="Utilities\BackupUtils.cs" />
    </ItemGroup>

    <ItemGroup>
        <!-- Pull MCP data access directly so we share the exact same code, not a project ref -->
        <Compile Include="..\GPConf.McpServer\DataAccess\GpConfDataAccess.cs" Link="DataAccess\GpConfDataAccess.cs" />
    </ItemGroup>

</Project>
