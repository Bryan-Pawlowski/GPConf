## A streamlined .gitignore for modern .NET projects
## including temporary files, build results, and
## files generated by popular .NET tools. If you are
## developing with Visual Studio, the VS .gitignore
## https://github.com/github/gitignore/blob/main/VisualStudio.gitignore
## has more thorough IDE-specific entries.
##
## Get latest from https://github.com/github/gitignore/blob/main/Dotnet.gitignore

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg

# Others
~$*
*~
CodeCoverage/

# MSBuild Binary and Structured Log
*.binlog

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

/.idea/
/packages/
riderModule.iml
/_ReSharper.Caches/

# Publish output and installer binaries
*/publish/
/publish/
/Installer/output/
/ExampleRaceData/
/.claude/

# Scratch / transient debug files from LLM-driven sessions
# (kept outside the repo; see the gpconf-race-session-ingest skill for the
# canonical standing files that *should* stay tracked under Python/)
/Python/__pycache__/
/Python/*.pyc
/Python/*.log
/Python/*_err.txt
/Python/test_*.py
/Python/try_*.py
/Python/verify_*.py
/Python/debug_*.py
/Python/check_*.py
/Python/args_*.json
/Python/mcp_server_err.txt
/Python/mcp_discord_*.py
/Python/verify_fix*.py
/Python/*_query.json
/Python/*_query2.json
/Python/baku_*.json
/Python/bahrain_*.json
/Python/all_*.py
/Python/count_*.py
/Python/list_*.json
/Python/get_season*.json
/Python/empty.json
/Python/season_*.json
/Python/ingest_*.py
/Python/parse_*.py
/Python/args_*.json
/Python/post_*.py
/Python/examine_*.py
/Python/_*
/Python/_probe.csproj
/Python/mcp_call.py

# RaceData: keep the scraped CSVs, ignore LLM-generated derivatives
/RaceData/converted/
/RaceData/__pycache__/
/RaceData/*_*.py

# Root-level transient files (LLM scratch)
/.az_*.txt
/az_*.md
/az_*.json
/f1-tulip-*
/nul
/season_arg.json
/tmp*
/bah_*.json